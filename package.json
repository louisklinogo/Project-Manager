{
  "name": "project-manager",
  "version": "0.1.0",
  "description": "A blueprint generator that researches, plans, and creates structured guidance for IDE coding LLMs to follow",
  "main": "index.js",
  "type": "module",
  "bin": {
    "project-manager": "project-manager/bin/project-manager.js",
    "project-manager-mcp": "project-manager/src/mcp-server/server.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "static-check": "npm run lint && npm run format:check",
    "start": "node index.js",
    "demo:task-hierarchy": "node --experimental-modules demos/blueprint/task-hierarchy-demo.js",
    "demo:ai-task-hierarchy": "node --experimental-modules demos/blueprint/ai-task-hierarchy-demo.js",
    "demo:research-module": "node --experimental-modules demos/research/research-module-demo.js",
    "demo:dependency-management": "node --experimental-modules demos/dependency/dependency-management-demo.js",
    "demo:enhanced-dependency-visualization": "node --experimental-modules demos/visualization/enhanced-dependency-visualization-demo.js",
    "demo:flow": "node --experimental-modules demos/flow/flow-demo.js",
    "demo:research-flow": "node --experimental-modules demos/research/research-flow-demo.js",
    "demo:gemini-test": "node --experimental-modules demos/research/gemini-test.js",
    "demo:perplexity-test": "node --experimental-modules demos/research/perplexity-test.js",
    "research": "node --experimental-modules demos/research/run-research-flow.js",
    "mvp": "node --experimental-modules demos/blueprint/mvp-demo.js",
    "mvp:load-blueprint": "node --experimental-modules demos/blueprint/load-blueprint-demo.js",
    "mvp:list-blueprints": "node --experimental-modules demos/blueprint/list-blueprints-demo.js",
    "demo:research-progress-console": "node --experimental-modules demos/visualization/research-progress-console-demo.js",
    "demo:research-progress-html": "node --experimental-modules demos/visualization/research-progress-html-demo.js",
    "demo:research-progress-file": "node --experimental-modules demos/visualization/research-progress-file-demo.js",
    "demo:research-orchestrator-visualizer": "node --experimental-modules demos/visualization/research-orchestrator-visualizer-demo.js",
    "test:flow": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=project-manager/tests/unit/flow",
    "test:coverage": "nyc --reporter=html --reporter=text node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage:research": "nyc --reporter=html --reporter=text node --experimental-vm-modules node_modules/jest/bin/jest.js project-manager/tests/unit/research",
    "test:coverage:synthesis": "nyc --reporter=html --reporter=text node --experimental-vm-modules node_modules/jest/bin/jest.js project-manager/tests/unit/research/synthesis",
    "test:comprehensive": "nyc --reporter=html --reporter=text node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --detectOpenHandles --forceExit",
    "test:quick": "node --experimental-vm-modules node_modules/jest/bin/jest.js --bail --findRelatedTests",
    "test:report": "npm test && start ./reports/test/index.html",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "llm",
    "blueprint",
    "planning",
    "research",
    "project-management"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@google/generative-ai": "^0.24.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.9.0",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^11.1.0",
    "d3": "^7.9.0",
    "dotenv": "^16.5.0",
    "fastmcp": "^1.20.5",
    "figlet": "^1.8.0",
    "inquirer": "^12.5.0",
    "mermaid": "^11.6.0",
    "openai": "^4.97.0",
    "ora": "^8.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.1.0",
    "lint-staged": "^15.2.2",
    "nyc": "^17.1.0",
    "prettier": "^3.5.3"
  }
}
